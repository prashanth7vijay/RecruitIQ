def test_user_with_no_recruiting_permission_cannot_read_pipeline_templates(client, db_session, test_company):
    from app.models.role import Role
    from app.models.user import User
    from app.services.auth_service import _hash_password

    empty_role = Role(company_id=None, name="no_permissions_role_test", is_system_role=True)
    db_session.add(empty_role)
    db_session.commit()
    powerless_user = User(
        company_id=test_company.id,
        email="powerless@acme-test.com",
        password_hash=_hash_password("correct-horse-battery-staple"),
        first_name="No",
        last_name="Permissions",
        role_id=empty_role.id,
        status="active",
    )
    db_session.add(powerless_user)
    db_session.commit()

    login = client.post(
        "/api/v1/auth/login",
        json={
            "company_slug": test_company.slug,
            "email": "powerless@acme-test.com",
            "password": "correct-horse-battery-staple",
        },
    )
    token = login.get_json()["data"]["access_token"]

    response = client.get(
        "/api/v1/pipeline-templates", headers={"Authorization": f"Bearer {token}"}
    )
    assert response.status_code == 403


