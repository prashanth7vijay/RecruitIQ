FLASK_ENV=development

DATABASE_URL=postgresql://recruitiq:recruitiq@postgres:5432/recruitiq
TEST_DATABASE_URL=postgresql://recruitiq:recruitiq@postgres:5432/recruitiq_test
REDIS_URL=redis://redis:6379/0

# AI Assist layer: 'ollama' (local Llama via a locally-running Ollama
# server — free, no API key, no cloud provider) or 'stub' (deterministic,
# no network call). Defaults to 'ollama' in development, 'stub' in tests.
# Run `ollama serve` and `ollama pull llama3.1:8b` before using ollama here.
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Required in production (see app/config.py REQUIRED_PRODUCTION_ENV_VARS).
# Dev/test fall back to insecure placeholder values automatically if unset —
# never rely on those fallbacks outside local development.
SECRET_KEY=change-me-to-a-random-64-char-value
JWT_SECRET_KEY=change-me-to-a-different-random-64-char-value
